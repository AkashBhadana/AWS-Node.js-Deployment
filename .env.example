# Copy to `.env` and replace the placeholder values.
#
# IMPORTANT:
# - Keep this file committed (safe placeholders only).
# - Never commit your real `.env` (it contains secrets).

# App
DOMAIN=http://localhost:3000
PORT=3000
STATIC_DIR=./client
LOG_LEVEL=info

# Stripe (required)
# Get these from the Stripe Dashboard (test mode).
PUBLISHABLE_KEY=pk_test_REPLACE_ME
SECRET_KEY=sk_test_REPLACE_ME

# Stripe Prices (at least ONE is required)
# Create a Product + Price in Stripe and copy the Price ID (looks like `price_...`).
WORKSHOP_PRICE_1=price_REPLACE_ME
WORKSHOP_PRICE_2=
WORKSHOP_PRICE_3=
